{
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "productcart/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/cron/notify",
      "schedule": "0 7 * * *"
    }
  ]
}
